# Copy to .env and fill in. Never commit the filled copy.
#
# Vite inlines these at startup, so restart the dev server after changing them.

# Google OAuth client id — the same value as the backend's GOOGLE_CLIENT_ID.
# Without it the Google sign-in button does not render; email/password still works.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Where the API lives. Leave this out when starting through dev.run.sh: the script
# derives it from BACKEND_PORT and exports it, so the two cannot disagree. Set it
# only to point the app at a backend the script did not start.
# VITE_API_BASE_URL=http://localhost:8001/api
