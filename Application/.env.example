# Copy to .env and fill in. Never commit the filled copy.

# Google OAuth client id, from the Google Cloud console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signing key for session tokens. At least 32 characters -- the app refuses to
# start below that, because an empty or short key can be brute-forced and every
# account forged. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Where the database is. Unset means the local SQLite file, which is what you
# want for development. For a deployment, paste Supabase's **transaction pooler**
# string here -- the one whose host contains `pooler.supabase.com` and whose port
# is 6543, not the direct `db.<ref>.supabase.co:5432` one, which is IPv6 only.
#
# Paste it exactly as the dashboard gives it, including the leading
# `postgresql://`: the app rewrites that to `postgresql+psycopg://` itself,
# because SQLAlchemy would otherwise look for psycopg2, which is not installed.
# Replace [YOUR-PASSWORD] with the database password.
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Serve the interactive API docs at /docs, /redoc and /openapi.json.
# Unset means OFF, which is the point: these publish every route, parameter and
# schema in the application, and they were public by accident. Set it to 1 for
# local development; never set it in production.
ENABLE_DOCS=1

# Who may CREATE an account, comma separated. Empty means anyone who can reach
# the server can register -- which is fine locally and wrong on the internet.
# Set it to the invited addresses before deploying; the server logs a warning
# at startup while it is unset.
#
# It gates joining, not signing in: an account that already exists keeps
# working whether or not its address is listed, and both the password and the
# Google paths are checked.
ALLOWED_SIGNUP_EMAILS=
