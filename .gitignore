# ---- Dependencies (regenerate with `npm ci`) ----
node_modules/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Build output (regenerate with `npm run build`) ----
dist/
.vite/

# ---- Local database ----
*.db
*.db-wal
*.db-shm
*.db.backup*
*.sqlite
*.sqlite3
# Ids of the seeded testing rows, so they can be removed precisely. Local-only
# state about a local-only database -- meaningless in anyone else's clone.
Application/backend/data/testing-data-manifest.json

# ---- OS / editor cruft ----
.DS_Store
*.swp

# ---- Deploy logs (Application/deploy.run.sh keeps failed runs here) ----
Application/.deploy-logs/
